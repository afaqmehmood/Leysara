{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'section-media.css' | asset_url | stylesheet_tag }}
<script src="{{ 'media.js' | asset_url }}" defer="defer"></script>

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{% liquid
	assign color_scheme = section.settings.color_scheme
	assign image_position = section.settings.image_position
	assign image_size = section.settings.image_size
	assign content_alignment = section.settings.content_alignment
%}

<div class='image-with-text {% if image_position == 'image_center' %} color-{{ color_scheme }} image-centered-layout {%- else -%} image-standard-layout {% endif %}'>
	<div
		class='container'
	>
		<div class='image-with-text__wrapper '>
			{% if image_position == 'image_center' %}
				{% if image_size != 'adapt' %}
					{% style %}
						#shopify-section-{{ section.id }} .image-with-text__media {
						  aspect-ratio: {{ image_size }};
						}
					{% endstyle %}
				{% endif %}
				<div class='image-with-text__centered  {% if image_size == 'adapt' %} centered-adapt {% endif %}'>
					<div class='image-with-text__content image-with-text__content--{{ content_alignment }}'>
						{% render 'section-header',
							section_heading: section.settings.heading,
							section_subheading: section.settings.subheading,
							dot: section.settings.dot,
							section_heading_size: section.settings.heading_size,
							line: section.settings.line
						%}

						{% if section.settings.text != blank %}
							<div class='image-with-text__text richtext__content'>
								{{ section.settings.text }}
							</div>
						{% endif %}
					</div>

					<div class='image-with-text__media {{ image_size }}'>
						{%- if section.settings.show_video != true -%}
							{%- if section.settings.image != blank -%}
								{%- if image_position == 'image_top'
									or image_position == 'image_bottom'
								-%}
									{%- assign widths = '360, 535, 720, 940, 1070, 1200, 1500, 1780, 2000' -%}
									{%- capture sizes -%}
										(min-width: 1200px) calc((100vw - 126px)), calc((100vw - 40px))
									{%- endcapture -%}
								{%- else -%}
									{%- capture sizes -%}
										(min-width: 1200px) calc((50vw - 64px)), calc((100vw - 40px))
									{%- endcapture -%}
									{%- assign widths = '360, 535, 720, 940, 1070, 1200, 1400, 1600' -%}
								{%- endif -%}
								{{
									section.settings.image
									| image_url: width: section.settings.image.width
									| image_tag: loading: 'lazy', sizes: sizes, widths: widths
								}}
							{%- else -%}
								{{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
							{%- endif -%}
						{%- endif -%}
						{% if section.settings.show_video == true %}
							{% if section.settings.video != blank or section.settings.video_url != blank %}
								{% liquid
								assign muted = section.settings.muted_video
			
								if section.settings.autoplay_video == true
									assign muted = true
								endif
								%}
			
								<div
								class="simple-media-card__video{% if section.settings.autoplay_video %} autoplay{% endif %}"
								data-video-id="{{ section.settings.video.id }}"
								{% if section.settings.loop_video == false %}
									data-video-loop="false"
								{% endif %}
								>
								{% if section.settings.video != blank %}
									{{
									section.settings.video
									| video_tag: image_size: '1920x', autoplay: section.settings.autoplay_video, loop: section.settings.loop_video, muted: muted
									}}
								{% else %}
									{%- if section.settings.video_url.type == 'youtube' -%}
									<iframe
										src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1&{%- if section.settings.autoplay_video -%}autoplay=1{%- else -%}autoplay=0{%- endif -%}{%- if muted == true -%}&mute=1{%- endif -%}&controls=0{%- if section.settings.loop_video -%}&playlist={{ section.settings.video_url.id }}&loop=1{%- endif -%}&rel=0"
										class="js-youtube{% if muted == true %} video-muted{% endif %}{% if section.settings.autoplay_video == false %} video-pause{% endif %}"
										allow="autoplay; encrypted-media"
										allowfullscreen
										title="{{ section.settings.description_video | escape }}"
										data-id="{{ section.settings.video_url.id }}"
									></iframe>
									{%- else -%}
									<iframe
										src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?{%- if section.settings.autoplay_video -%}autoplay=1&autopause=0{%- else -%}autoplay=0{%- endif -%}{%- if muted == true -%}&muted=1{%- endif -%}&controls=false{%- if section.settings.loop_video -%}&loop=1{%- endif -%}"
										class="js-vimeo{% if muted == true %} video-muted{% endif %}{% if section.settings.autoplay_video == false %} video-pause{% endif %}"
										allow="autoplay; encrypted-media"
										frameborder="0"
										allowfullscreen
										title="{{ section.settings.description_video | escape }}"
										data-id="{{ section.settings.video_url.id }}"
									></iframe>
									{%- endif -%}
								{% endif %}
								</div>
								{% if section.settings.show_icon_play or section.settings.show_icon_sound %}
								<div class="simple-media-card__video-buttons">
									{% if section.settings.show_icon_play %}
									<button
										class="button--unstyled button--play js-play-video{% if section.settings.autoplay_video %} active{% endif %}"
										aria-label=" {{ 'general.video.play' | t }}"
									>
										<span>
										<span class="button-icon button-icon-pause">
											{% render 'icon-pause' %}
										</span>
										<span class="button-icon button-icon-play">
											{% render 'icon-play-media' %}
										</span>
										</span>
									</button>
									{% endif %}
									{% if section.settings.show_icon_sound %}
									<button
										class="button--unstyled button--sound js-sound-video"
										{{ 'general.video.sound' | t }}
									>
										<span>
										<span class="button-icon {% if muted == false %} icon-hidden {% endif %}">
											{% render 'icon-sound-off' %}
										</span>
										<span class="button-icon {% if muted == true %} icon-hidden {% endif %}">
											{% render 'icon-sound-on' %}
										</span>
										</span>
									</button>
									{% endif %}
								</div>
								{% endif %}
							{% endif %}
						{% endif %}
					</div>

					{% if section.settings.button_label != blank %}
						<div class='button-container image-with-text__button-container--{{ content_alignment }}'>
							{% render 'button',
								btn_label: section.settings.button_label,
								btn_link: section.settings.button_link,
								btn_style: section.settings.button_style,
								button_dot: section.settings.button_dot,
								add_classes: 'image-with-text__button focus-inset'
							%}
						</div>
					{%- endif -%}
				</div>
			{%- elsif image_position != 'image_center' -%}
				<div class='image-with-text__grid image-with-text__grid--{{ image_position }}'>
					{% if image_size != 'adapt' %}
						{% style %}
							#shopify-section-{{ section.id }} .image-with-text__media {
							  aspect-ratio: {{ image_size }};
							}
						{% endstyle %}
					{% endif %}
					<div class='image-with-text__media {{ image_size }}'>
						{%- if section.settings.show_video != true -%}
							{%- if section.settings.image != blank -%}
								{%- if image_position == 'image_top'
									or image_position == 'image_bottom'
								-%}
									{%- assign widths = '360, 535, 720, 940, 1070, 1200, 1500, 1780, 2000' -%}
									{%- capture sizes -%}
										(min-width: 1200px) calc((100vw - 126px)), calc((100vw - 40px))
									{%- endcapture -%}
								{%- else -%}
									{%- capture sizes -%}
										(min-width: 1200px) calc((50vw - 64px)), calc((100vw - 40px))
									{%- endcapture -%}
									{%- assign widths = '360, 535, 720, 940, 1070, 1200, 1400, 1600' -%}
								{%- endif -%}
								{{
									section.settings.image
									| image_url: width: section.settings.image.width
									| image_tag: loading: 'lazy', sizes: sizes, widths: widths
								}}
							{%- else -%}
								{{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
							{%- endif -%}
						{%- endif -%}
						
						{% if section.settings.show_video == true %}
							{% if section.settings.video != blank or section.settings.video_url != blank %}
								{% liquid
								assign muted = section.settings.muted_video
			
								if section.settings.autoplay_video == true
									assign muted = true
								endif
								%}
			
								<div
								class="simple-media-card__video{% if section.settings.autoplay_video %} autoplay{% endif %}"
								data-video-id="{{ section.settings.video.id }}"
								{% if section.settings.loop_video == false %}
									data-video-loop="false"
								{% endif %}
								>
								{% if section.settings.video != blank %}
									{{
									section.settings.video
									| video_tag: image_size: '1920x', autoplay: section.settings.autoplay_video, loop: section.settings.loop_video, muted: muted
									}}
								{% else %}
									{%- if section.settings.video_url.type == 'youtube' -%}
									<iframe
										src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1&{%- if section.settings.autoplay_video -%}autoplay=1{%- else -%}autoplay=0{%- endif -%}{%- if muted == true -%}&mute=1{%- endif -%}&controls=0{%- if section.settings.loop_video -%}&playlist={{ section.settings.video_url.id }}&loop=1{%- endif -%}&rel=0"
										class="js-youtube{% if muted == true %} video-muted{% endif %}{% if section.settings.autoplay_video == false %} video-pause{% endif %}"
										allow="autoplay; encrypted-media"
										allowfullscreen
										title="{{ section.settings.description_video | escape }}"
										data-id="{{ section.settings.video_url.id }}"
									></iframe>
									{%- else -%}
									<iframe
										src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?{%- if section.settings.autoplay_video -%}autoplay=1&autopause=0{%- else -%}autoplay=0{%- endif -%}{%- if muted == true -%}&muted=1{%- endif -%}&controls=false{%- if section.settings.loop_video -%}&loop=1{%- endif -%}"
										class="js-vimeo{% if muted == true %} video-muted{% endif %}{% if section.settings.autoplay_video == false %} video-pause{% endif %}"
										allow="autoplay; encrypted-media"
										frameborder="0"
										allowfullscreen
										title="{{ section.settings.description_video | escape }}"
										data-id="{{ section.settings.video_url.id }}"
									></iframe>
									{%- endif -%}
								{% endif %}
								</div>
								{% if section.settings.show_icon_play or section.settings.show_icon_sound %}
								<div class="simple-media-card__video-buttons">
									{% if section.settings.show_icon_play %}
									<button
										class="button--unstyled button--play js-play-video{% if section.settings.autoplay_video %} active{% endif %}"
										aria-label=" {{ 'general.video.play' | t }}"
									>
										<span>
										<span class="button-icon button-icon-pause">
											{% render 'icon-pause' %}
										</span>
										<span class="button-icon button-icon-play">
											{% render 'icon-play-media' %}
										</span>
										</span>
									</button>
									{% endif %}
									{% if section.settings.show_icon_sound %}
									<button
										class="button--unstyled button--sound js-sound-video"
										{{ 'general.video.sound' | t }}
									>
										<span>
										<span class="button-icon {% if muted == false %} icon-hidden {% endif %}">
											{% render 'icon-sound-off' %}
										</span>
										<span class="button-icon {% if muted == true %} icon-hidden {% endif %}">
											{% render 'icon-sound-on' %}
										</span>
										</span>
									</button>
									{% endif %}
								</div>
								{% endif %}
							{% endif %}
						{% endif %}
					</div>
					<div class='image-with-text__content color-{{ color_scheme }} image-with-text__content--{{ content_alignment }} image-with-text__content--{{ image_position }}'>
						{% render 'section-header',
							section_heading: section.settings.heading,
							section_subheading: section.settings.subheading,
							dot: section.settings.dot,
							section_heading_size: section.settings.heading_size,
							line: section.settings.line
						%}

						{% if section.settings.text != blank %}
							<div class='image-with-text__text richtext__content'>
								{{ section.settings.text }}
							</div>
						{% endif %}

						{% if section.settings.button_label != blank %}
							{% render 'button',
								btn_label: section.settings.button_label,
								btn_link: section.settings.button_link,
								btn_style: section.settings.button_style,
								button_dot: section.settings.button_dot,
								add_classes: 'image-with-text__button focus-inset'
							%}
						{%- endif -%}
					</div>
				</div>
			{% endif %}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "multimedia-with-text",
	"class": "multimedia-with-text-section image-with-text-section media-section spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-2",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "select",
			"id": "image_position",
			"options": [
				{
					"value": "image_top",
					"label": "t:sections.image-with-text.settings.image_position.options__1.label"
				},
				{
					"value": "image_right",
					"label": "t:sections.image-with-text.settings.image_position.options__2.label"
				},
				{
					"value": "image_left",
					"label": "t:sections.image-with-text.settings.image_position.options__3.label"
				},
				{
					"value": "image_bottom",
					"label": "t:sections.image-with-text.settings.image_position.options__4.label"
				},
				{
					"value": "image_center",
					"label": "t:sections.image-with-text.settings.image_position.options__5.label"
				}
			],
			"default": "image_left",
			"label": "t:sections.image-with-text.settings.image_position.label"
		},
        {
          "type": "checkbox",
          "id": "show_video",
          "label": "t:sections.media.blocks.media_card.settings.show_video.label",
          "default": false
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.media.blocks.media_card.settings.video.label"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "accept": ["youtube", "vimeo"],
          "default": "https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc",
          "label": "t:sections.media.blocks.media_card.settings.video_url.label",
          "info": "t:sections.media.blocks.media_card.settings.video_url.info"
        },
        {
          "type": "checkbox",
          "id": "autoplay_video",
          "label": "t:sections.media.blocks.media_card.settings.autoplay_video.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "muted_video",
          "label": "t:sections.media.blocks.media_card.settings.muted_video.label",
          "info": "t:sections.media.blocks.media_card.settings.muted_video.info",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "loop_video",
          "label": "t:sections.media.blocks.media_card.settings.loop_video.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_icon_play",
          "label": "t:sections.media.blocks.media_card.settings.show_icon_play.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_icon_sound",
          "label": "t:sections.media.blocks.media_card.settings.show_icon_sound.label",
          "default": true
        },
        {
          "type": "text",
          "id": "description_video",
          "label": "t:sections.media.blocks.media_card.settings.description_video.label",
          "info": "t:sections.media.blocks.media_card.settings.description_video.info"
        },

		{
			"type": "select",
			"id": "content_alignment",
			"default": "left",
			"label": "t:sections.all.content_alignment.label",
			"options": [
				{
					"value": "left",
					"label": "t:sections.all.content_alignment.options.options__2.label"
				},
				{
					"value": "center",
					"label": "t:sections.all.content_alignment.options.options__1.label"
				}
			]
		},
		{
			"type": "header",
			"content": "t:sections.all.image.header.content"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:sections.all.image.label"
		},
		{
			"type": "select",
			"id": "image_size",
			"default": "1/1",
			"label": "t:sections.all.image.aspect_ratio.label",
			"options": [
				{
					"value": "1/1",
					"label": "t:sections.all.image.aspect_ratio.options__1.label"
				},
				{
					"value": "3/2",
					"label": "t:sections.all.image.aspect_ratio.options__2.label"
				},
				{
					"value": "3/4",
					"label": "t:sections.all.image.aspect_ratio.options__3.label"
				},
				{
					"value": "4/3",
					"label": "t:sections.all.image.aspect_ratio.options__4.label"
				},
				{
					"value": "16/9",
					"label": "t:sections.all.image.aspect_ratio.options__5.label"
				},
				{
					"value": "21/9",
					"label": "t:sections.all.image.aspect_ratio.options__6.label"
				},
				{
					"value": "adapt",
					"label": "t:sections.all.image.aspect_ratio.options__7.label"
				}
			]
		},
		{
			"type": "header",
			"content": "t:sections.all.content_options.header.content"
		},
		{
			"type": "text",
			"id": "subheading",
			"default": "Some Subheading",
			"label": "t:sections.all.subheading.label"
		},
		{
			"type": "checkbox",
			"id": "dot",
			"default": true,
			"label": "t:sections.all.section-header.dot.label"
		},
		{
			"type": "text",
			"id": "heading",
			"default": "Some heading for this section",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:sections.all.heading_size.options__4.label"
				},
				{
					"value": "h3",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__3.label"
				}
			],
			"default": "h1",
			"label": "t:sections.all.heading_size.label"
		},
		{
			"type": "richtext",
			"id": "text",
			"default": "<p>Description of your company, products, collections, and so on. There may be several paragraphs here.</p>",
			"label": "t:sections.all.text.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.button.header_button.content"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "Button Label",
			"label": "t:sections.all.button.button_label.label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:sections.all.button.button_link.label"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "t:sections.all.button.button_style.options__1.label"
				},
				{
					"value": "secondary",
					"label": "t:sections.all.button.button_style.options__2.label"
				},
				{
					"value": "tertiary",
					"label": "t:sections.all.button.button_style.options__3.label"
				}
			],
			"default": "primary",
			"label": "t:sections.all.button.button_style.label"
		},
		{
			"type": "checkbox",
			"id": "button_dot",
			"default": true,
			"label": "t:sections.all.button.button_dot.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "s",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
