{% comment %}
  Accordion met 3 metafields: specs, formaten, verzendinformatie
{% endcomment %}

<div class="product-accordion">
  {% if product.metafields.custom.specs %}
    <details>
      <summary>Specificaties</summary>
      <div>{{ product.metafields.custom.specs | metafield_tag }}</div>
    </details>
  {% endif %}

  {% if product.metafields.custom.formaten %}
    <details>
      <summary>Formaten</summary>
      <div>{{ product.metafields.custom.formaten | metafield_tag }}</div>
    </details>
  {% endif %}

  {% if product.metafields.custom.verzendinformatie %}
    <details>
      <summary>Verzendinformatie</summary>
      <div>{{ product.metafields.custom.verzendinformatie | metafield_tag }}</div>
    </details>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product Accordion",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Product Accordion"
    }
  ]
}
{% endschema %}
